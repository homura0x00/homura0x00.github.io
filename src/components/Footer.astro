    <div class="relative max-w-7xl mx-auto lg:px-8">
      <div class="relative">
        <HelpLists client:load />
      </div>
      <div class="mt-12 text-sm text-muted-foreground">
        <p>&copy; 2023-2026</p>
      </div>
      <div class="mt-6 flex md:absolute md:bottom-0 md:right-0 md:mt-0 md:flex-row">
        <SwitchMode client:load />
      </div>
    </div>
  </div>
</footer>