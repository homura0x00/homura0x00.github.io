---
import Menu from "./Menu.astro";
import Navigation from "./Navigation.astro";
import ThemeIcon from "./ThemeIcon.astro";
---

<header>
    <nav>
        <Navigation />
        <div>
            <ThemeIcon />
            <Menu />
        </div>
    </nav>
</header>

<style>
header {
    border: 1px solid gray;
    position: relative;
    height: 100%;
}

nav {
    display: flex;
    width: 80%;
    margin: 0 auto;
    justify-content: space-between;
}

div {
   display: flex;
   justify-content: space-between;
 }
</style>