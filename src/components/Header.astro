---
import BaseNavigation from "./Navigation";
import MobileNavigation from "./MobileNavigation";
import { HeaderModeToggle } from "./HeaderModeToggle";
import MyAvatar from "@/components/MyAvatar";
import { Button } from "./ui/button";
import { DoorOpen } from "lucide-react";
---

<header id="main-header" class="flex z-50 fixed left-0 right-0 top-0 items-center transition-all duration-300 border-b border-transparent">
    <div class="flex lg:max-w-7xl w-full mx-auto justify-between m-4 px-6 md:px-10 items-center">
        <!-- Mobile Menu Button (Left) -->
        <div class="md:hidden">
            <MobileNavigation client:load />
        </div>

        <!-- Avatar (Center on Mobile, Left on Desktop) -->
        <div class="flex-1 md:flex-none flex justify-center md:justify-start">
            <a href="/">
                <MyAvatar client:load uri="https://avatars.githubusercontent.com/u/61085099?v=4" title="@homura" />
            </a>
        </div>

        <!-- Desktop Navigation (Center) -->
        <div class="hidden md:block flex-1">
            <div class="flex justify-center">
                <BaseNavigation client:load />
            </div>
        </div>

        <div class="flex-none">
            <Button variant="outline" size="icon">
                <!-- <a href="/login" target="_blank" rel="noopener noreferrer"> -->
                    <DoorOpen />
                <!-- </a> -->
            </Button>
        </div> <!-- 占位元素，保持右侧按钮位置 -->

        <!-- Theme Toggle Button (Right) -->
        <!-- <div class="flex-none">
            <HeaderModeToggle client:load />
        </div> -->
    </div>
</header>

<script>
    function initHeader() {
        const header = document.getElementById('main-header');
        if (!header) return;

        const updateHeader = () => {
            if (window.scrollY > 20) {
                header.classList.add('bg-white/70', 'dark:bg-zinc-950/70', 'backdrop-blur-md', 'shadow-sm', 'border-zinc-200/50', 'dark:border-zinc-800/50');
                header.classList.remove('border-transparent');
            } else {
                header.classList.remove('bg-white/70', 'dark:bg-zinc-950/70', 'backdrop-blur-md', 'shadow-sm', 'border-zinc-200/50', 'dark:border-zinc-800/50');
                header.classList.add('border-transparent');
            }
        };

        // Initial check
        updateHeader();

        // Listen for scroll
        window.addEventListener('scroll', updateHeader);
        
        // Cleanup function for Astro transitions
        return () => {
            window.removeEventListener('scroll', updateHeader);
        };
    }

    // Run on initial load
    initHeader();

    // Run on view transitions
    document.addEventListener('astro:page-load', initHeader);
</script>
