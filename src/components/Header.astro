---
import Menu from "./Menu.astro";
import Navigation from "./Navigation.astro";
import ThemeIcon from "./ThemeIcon.astro";
---

<header>
    <nav>
        <Navigation />
        <div>
            <ThemeIcon />
            <Menu />
        </div>
    </nav>
</header>

<style>
header {
    border-bottom: 1px solid gray;
    
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
}

nav {
    display: flex;
    width: 1080px;
    margin: 0 auto;
    justify-content: space-between;
}

div {
   display: flex;
   justify-content: space-between;
 }
</style>