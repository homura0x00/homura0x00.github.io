---
import Prose from "@/components/Prose.astro";
import BaseLayout from "./BaseLayout.astro";
import { Badge } from "@/components/ui/badge"
const { frontmatter } = Astro.props;

let isImage: boolean = false;

if (frontmatter.image) {
    isImage = true;
}
---

<BaseLayout pageTitle={frontmatter.title}>
    <div class="mx-auto max-w-4xl px-6 md:px-10 py-10 min-h-screen">
        <Prose>
            <h1>{frontmatter.title}</h1>
        </Prose>

        <div class="text-gray-400">
            <p>发布于：{frontmatter.pubDate.toString().slice(0, 10)}</p>
            <p>Description：<em>{frontmatter.description}</em></p>
            <p>作者：{frontmatter.author}</p>
        </div>

        <div class="my-4">
        { isImage ? <img src={frontmatter.image?.url} width="100%" alt={frontmatter.image?.alt} /> : <></> }
        </div>

        <div class="tags" class="my-4">
            {
                frontmatter.tags.map((tag: string) => (
                    <div class="m-2">
                        <Badge key={tag} variant="secondary">
                            <a href={`/tags/${tag}`}>{tag}</a>
                        </Badge>

                    </div>
                ))
            }
        </div>
        <div class="max-w-full my-4 prose dark:prose-invert">
            <slot />
        </div>
    </div>
</BaseLayout>
<style>
    a {
        color: #00539f;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
    }
</style>
