---
import { MapPin } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "关于我";

const identity = {
    firstName: "homura",
    country: "Hongkong, China",
    occupation: "码农",
    hobbies: ["打游戏", "看动漫"],
};

const journey = [
    {
        year: "NOW",
        title: "AGI 架构师",
        description:
            "项目 AI驱动 TDD 流程设计，AI harness 工程",
    },
    {
        year: "2024~",
        title: "AI Agent",
        description: "技术栈：Mastra.js、LangChain",
    },
    {
        year: "2023~",
        title: "Go全栈开发",
        description: "技术栈：Golang、Gin、Gorm、React、MySQL",
    },
];

const skills = [
    "Python",
    "Ai",
    "React",
    "JS/TS",
    "Golang",
    "Java",
    "Astro",
    "Rust",  
];
---

<BaseLayout pageTitle={pageTitle}>
    <div class="mx-auto max-w-5xl px-6 md:px-10 py-16 min-h-screen">

        <span class="mb-12 block text-xs tracking-[2px] text-muted-foreground">
            ABOUT
        </span>

        <!-- Intro -->
        <div class="text-muted-foreground leading-relaxed space-y-2 mb-14">
            <p>
                Hi，我是 <strong class="text-foreground">{identity.firstName}</strong>。一个顺心而为的独立开发者。
            </p>
            <p>
                工具是手的延伸，AI 是思想的延伸。学会用它，而不是被它带着走。
            </p>
            <div class="flex items-center gap-1.5 pt-1">
                <MapPin className="size-3.5" />
                <span class="text-sm">{identity.country}</span>
            </div>
        </div>

        <!-- Journey -->
        <h2 class="text-foreground font-medium mb-6">历程</h2>
        <div class="mb-14">
            {journey.map((item, i) => (
                <div>
                    <div class="flex gap-4">
                        <!-- 左侧：圆点 + 时间线 -->
                        <div class="relative flex flex-col items-center">
                            <div class={`size-2 rounded-full shrink-0 mt-1.5 ${
                                i === 0 ? "bg-transparent ring-2 ring-foreground" : "bg-primary/30"
                            }`} />
                            <div class="w-px flex-1 bg-border" />
                        </div>
                        <!-- 右侧：年份列 + 内容列 -->
                        <div class="flex-1 min-w-0 flex gap-3 pb-6">
                            <span class="w-10 shrink-0 text-sm text-muted-foreground/60 font-mono text-right">
                                {item.year}
                            </span>
                            <div>
                                <p class="text-sm font-medium text-foreground">{item.title}</p>
                                <p class="text-sm text-muted-foreground leading-relaxed mt-0.5">
                                    {item.description}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            ))}
            <!-- ... 节点：未完待续 -->
            <div class="flex gap-4">
                <div class="relative flex flex-col items-center">
                    <div class="size-2 rounded-full bg-border shrink-0 mt-1.5" />
                    <div class="w-px h-4 bg-border" />
                </div>
                <div class="flex-1 min-w-0 flex gap-3">
                    <span class="w-10 shrink-0 text-sm text-muted-foreground/50 font-mono text-right tracking-[3px]">...</span>
                    <div></div>
                </div>
            </div>
        </div>

        <!-- Skills -->
        <h2 class="text-foreground font-medium mb-5">Skills</h2>
        <div class="flex flex-wrap gap-x-4 gap-y-2 mb-14">
            {skills.map((skill) => (
                <span class="text-sm text-muted-foreground">{skill}</span>
            ))}
        </div>

        <!-- Hobbies -->
        {identity.hobbies.length >= 2 && (
            <p class="text-sm text-muted-foreground">
                兴趣：{identity.hobbies[0]}、{identity.hobbies[1]}
            </p>
        )}

    </div>
</BaseLayout>