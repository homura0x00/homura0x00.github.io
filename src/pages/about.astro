---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "关于我";

const identity = {
    firstName: "homura",
    country: "Hongkong, China",
    occupation: "技术撰稿人",
    hobbies: ["打游戏", "看动漫"],
};

const skills = ["React", "Astro", "Writing Docs", "Golang", "Java", "Ai"];
---

<BaseLayout pageTitle={pageTitle}>
    <div class="mx-auto max-w-5xl px-6 md:px-10 py-16 min-h-screen">
        <span class="mb-8 block text-xs tracking-[2px] text-muted-foreground">
            ABOUT
        </span>

        <div class="space-y-6">
            <p class="text-foreground leading-relaxed">
                我是 <strong>{identity.firstName}</strong>，来自 {identity.country}，是一名{identity.occupation}。
            </p>

            {identity.hobbies.length >= 2 && (
                <p class="text-muted-foreground leading-relaxed">
                    兴趣：{identity.hobbies[0]}、{identity.hobbies[1]}
                </p>
            )}

            <div>
                <p class="text-muted-foreground mb-3">技能</p>
                <div class="flex flex-wrap gap-2">
                    {skills.map((skill) => (
                        <span class="rounded-md bg-accent/5 px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-accent/10">
                            {skill}
                        </span>
                    ))}
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
