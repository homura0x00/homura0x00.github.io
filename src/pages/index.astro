---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeLinks from '@/components/home-links';
import { ChevronDown } from 'lucide-react';
const pageTitle = "Home";
---

<BaseLayout pageTitle={pageTitle}>

	<!-- Hero Section -->
	<div id="home" class="relative mx-auto min-h-screen max-w-7xl flex flex-col-reverse items-center justify-center px-6 md:px-10
		lg:flex-row lg:gap-32">

		<!-- Left: Intro -->
		<div class="flex flex-col justify-center w-full lg:w-auto lg:flex-1">
			<div class="text-center lg:text-left">
				<p class="text-base md:text-lg lg:text-xl text-muted-foreground">
					Hi, I'm <span class="font-medium text-foreground">homura</span>
				</p>
				<div class="mt-2 md:mt-3">
					<span class="text-lg md:text-xl lg:text-2xl text-muted-foreground">A Full Stack </span>
					<code class="font-medium text-accent text-lg md:text-xl lg:text-2xl">&lt;Developer /&gt;</code>
				</div>
				<p class="text-sm md:text-base text-muted-foreground/70 mt-1">from China</p>
			</div>

			<div class="mt-8 lg:mt-12 flex justify-center lg:justify-start">
				<HomeLinks client:load />
			</div>
		</div>

		<!-- Right: Avatar -->
		<div class="flex shrink-0 justify-center lg:justify-end mb-6 lg:mb-0">
			<img
				class="rounded-full size-28 md:size-36 lg:size-56"
				src="https://avatars.githubusercontent.com/u/61085099?v=4"
				alt="avatar"
			/>
		</div>

	</div>

	<!-- Scroll hint -->
	<div class="hidden lg:flex absolute bottom-8 left-1/2 -translate-x-1/2 flex-col items-center gap-1 text-muted-foreground/40 animate-bounce">
		<span class="text-xs tracking-[2px]">SCROLL</span>
		<ChevronDown className="size-4" />
	</div>

</BaseLayout>

<style>
	#home {
		min-height: 100dvh;
	}
</style>