---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const pageTitle = "Blog"
const posts = await getCollection("blog");
---


<BaseLayout pageTitle={pageTitle}>
    <div class="mx-auto max-w-5xl px-6 md:px-10 py-16 min-h-screen">
        <span class="mb-8 block text-xs tracking-[2px] text-muted-foreground">
            BLOG
        </span>

        <h1 class="text-lg font-medium text-foreground mb-5">Post</h1>
        <ul class="space-y-2">
            {posts.map((post: any) => (
                <li>
                    <a
                        href={`/blog/${post.id}`}
                        class="block rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-accent/5 hover:text-foreground"
                    >
                        {post.data.title}
                    </a>
                </li>
            ))}
        </ul>
    </div>
</BaseLayout>
