---
import Prose from "@/components/Prose.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection} from "astro:content";

const allPosts = Object.values(import.meta.glob('../posts/blog/*.md', { eager: true }));
const pageTitle = "我的 Astro 学习博客"
const posts = await getCollection("blog");
---


<BaseLayout pageTitle={pageTitle}>
    <div class="mx-auto max-w-5xl px-6 md:px-10 py-10 min-h-screen">
        <Prose>
            <h2>这是我的 Astro 学习笔记</h2>
        </Prose>
        <div class="mt-10">
            <ul>
                {posts.map((post: any) => <li><a href={`/blog/${post.id}`}>{post.data.title}</a></li>)}
            </ul>
        </div>
    </div>
</BaseLayout>

<style>
</style>
