---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const blogPosts = await getCollection("blog");
    const writeupPosts = await getCollection("writeup");
    const allPosts = [...blogPosts, ...writeupPosts];

    const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat())].filter(Boolean) as string[];

    return uniqueTags.map((tag) => {
        const filteredPosts = allPosts.filter((post) => post.data.tags?.includes(tag));
        return {
            params: { tag },
            props: { posts: filteredPosts },
        };
    });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout pageTitle={tag}>
    <div class="mx-auto max-w-5xl px-6 md:px-10 py-16 min-h-screen">
        <span class="mb-8 block text-xs tracking-[2px] text-muted-foreground">
            TAGS / {tag}
        </span>

        <ul class="space-y-3">
            {posts.map((post) => (
                <li class="group">
                    <a
                        href={`/${post.collection}/${post.id}`}
                        class="flex items-center gap-3 rounded-md px-3 py-2 text-foreground transition-colors hover:bg-accent/5"
                    >
                        <span class="w-1.5 h-1.5 rounded-full bg-border group-hover:bg-accent transition-colors shrink-0"></span>
                        <span class="text-sm">{post.data.title}</span>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</BaseLayout>
