---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const blogPosts = await getCollection("blog");
const writeupPosts = await getCollection("writeup");
const allPosts = [...blogPosts, ...writeupPosts];

const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())].filter(Boolean) as string[];
const pageTitle = "标签索引";

// 统计每个标签的文章数，按数量降序排列
const tagCounts: Record<string, number> = {};
tags.forEach((tag) => {
  tagCounts[tag] = allPosts.filter((post) => post.data.tags?.includes(tag)).length;
});
const sortedTags = [...tags].sort((a, b) => tagCounts[b] - tagCounts[a]);
const maxCount = Math.max(...Object.values(tagCounts), 1);
---

<BaseLayout pageTitle={pageTitle}>
  <div class="mx-auto max-w-5xl px-6 md:px-10 py-16 min-h-screen">
    <span class="mb-8 block text-xs tracking-[2px] text-muted-foreground">
      TAGS
    </span>

    <div class="flex flex-wrap gap-3">
      {sortedTags.map((tag) => {
        const count = tagCounts[tag];
        // 按文章数量决定大小权重
        const weight = count / maxCount;
        const size = weight > 0.5 ? "px-4 py-2 text-sm" : "px-3 py-1.5 text-sm";

        return (
          <a
            href={`/tags/${tag}`}
            class={`${size} rounded-full bg-accent/5 text-muted-foreground transition-all hover:bg-accent/10 hover:text-foreground hover:scale-105 no-underline flex items-center gap-1.5`}
          >
            <span>{tag}</span>
            <span class="text-xs text-muted-foreground/60">({count})</span>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>