---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Badge } from "@/components/ui/badge";

const blogPosts = await getCollection("blog");
const writeupPosts = await getCollection("writeup");
const allPosts = [...blogPosts, ...writeupPosts];

const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())].filter(Boolean) as string[];
const pageTitle = "标签索引";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="mx-auto max-w-5xl px-6 md:px-10 py-10 min-h-screen text-center">
    <h1 class="text-4xl font-bold mb-10">{pageTitle}</h1>
    
    <div class="flex flex-wrap justify-center gap-4">
      {
        tags.map((tag) => (
          <Badge variant="secondary" className="px-4 py-2 text-lg hover:bg-primary hover:text-white transition-all cursor-pointer">
            <a href={`/tags/${tag}`} class="no-underline">{tag}</a>
          </Badge>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
</style>